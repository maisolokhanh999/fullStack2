# Sao chép thành .env.local để override khi chạy local. Không commit file thật.
#
# CẢNH BÁO: mọi biến VITE_* đều được nhúng công khai vào bundle client và chốt
# tại thời điểm build — không bao giờ đặt secret ở đây, và phải build lại khi đổi.

# Origin của backend, KHÔNG thêm hậu tố /api (backend mount route ngay tại gốc).
# Bỏ trống sẽ dùng mặc định trong src/services/apiClient.js.
VITE_API_BASE_URL=
