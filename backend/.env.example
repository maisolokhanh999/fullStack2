# Sao chép file này thành .env rồi điền giá trị thật. Không commit .env.

# MongoDB — dùng MONGODB_URL. Ba biến còn lại chỉ là alias fallback trong
# configs/db.js, giữ lại cho tương thích ngược; môi trường mới chỉ cần MONGODB_URL.
MONGODB_URL=
MONGODB_URI=
MONGO_URI=
CONST_MONGODB_URL=

# Khoá ký/xác minh JWT. Bắt buộc đặt giá trị mạnh và riêng cho từng môi trường:
# nếu thiếu, server.js rơi về fallback hard-code chỉ dành cho dev.
JWT_SECRET=

# Cloudinary — dùng cho upload ảnh món ăn/thực đơn.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cổng HTTP. Mặc định 5000 nếu bỏ trống.
PORT=
